# ============================================================
# LLM PROVIDER — pick ONE (the agent's reasoning brain)
# ============================================================
# Default is Venice (the "Best use of Venice AI" track). Without any provider the
# agent falls back to a deterministic heuristic reader (demo still works).

# (A) Venice AI — the sponsor track. Set this key:
VENICE_API_KEY=your_venice_api_key
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=venice-uncensored-1-2

# (B) FREE local Ollama (no key, no cost). Uncomment to use instead of Venice:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:latest              # follows the injection reliably (good demo)

# (C) Any OpenAI-compatible provider (Groq/OpenRouter free tiers, etc.):
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_key
# LLM_MODEL=llama-3.3-70b-versatile

# 1Shot permissionless relayer is KEYLESS — no API key/secret/business id needed.
# The client hits https://relayer.1shotapi.com/relayers directly. Nothing to set.

# Chain (Base Sepolia) + EIP-3009 test USDC.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Demo counterparties (any addresses; merchant = the only allowed payee).
# DEMO_MERCHANT=0x1111111111111111111111111111111111111111
# DEMO_ATTACKER=0x2222222222222222222222222222222222222222

# Backend host/port + CORS. Set CORS_ORIGINS to your deployed frontend URL.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
